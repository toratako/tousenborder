{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer review notes for a problem catalog",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_pack": {"type": "string", "pattern": "^res://"},
    "reviews": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/review"}
    }
  },
  "required": ["schema_version", "content_pack", "reviews"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "review": {
      "type": "object",
      "properties": {
        "overview": {"$ref": "#/$defs/text"},
        "flow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "resource_id": {"$ref": "#/$defs/text"},
              "action": {"$ref": "#/$defs/text"}
            },
            "required": ["resource_id", "action"],
            "additionalProperties": false
          }
        },
        "decisive_evidence": {"$ref": "#/$defs/text"},
        "review_notes": {"$ref": "#/$defs/text"}
      },
      "required": ["overview", "flow", "decisive_evidence"],
      "additionalProperties": false
    }
  }
}
