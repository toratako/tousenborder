{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/text"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "sampling": {
      "type": "object",
      "properties": {
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": ["count"],
      "additionalProperties": false
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "problems"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
