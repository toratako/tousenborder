{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/text"
    },
    "category": {
      "$ref": "#/$defs/text"
    },
    "category_label": {
      "$ref": "#/$defs/text"
    },
    "platform": {
      "enum": [
        "windows",
        "linux",
        "common"
      ]
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "request": {
      "$ref": "#/$defs/text"
    },
    "initial": {
      "type": "object",
      "properties": {
        "information": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "information"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_alternatives": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence_alternative"
      }
    },
    "ground_truth": {
      "enum": [
        "allow",
        "block"
      ]
    },
    "explanation": {
      "$ref": "#/$defs/text"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^/\\s]+(?:/\\S*)?$"
      },
      "uniqueItems": true
    },
    "inspired_by": {
      "$ref": "#/$defs/text"
    },
    "glossary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "description": {
            "$ref": "#/$defs/text"
          }
        },
        "required": [
          "label",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "category",
    "platform",
    "title",
    "request",
    "initial",
    "resources",
    "required_evidence",
    "ground_truth",
    "explanation"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone security learning problem",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "input_binding": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "additionalProperties": false
    },
    "evidence_alternative": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "any_of": {
          "$ref": "#/$defs/texts"
        }
      },
      "required": [
        "label",
        "any_of"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "data_type": {
          "$ref": "#/$defs/text"
        },
        "tool_input": {
          "type": "boolean"
        },
        "draggable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "data_type"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/value"
        },
        "information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "by_environment": {
          "type": "object",
          "properties": {
            "windows": {
              "$ref": "#/$defs/text"
            },
            "linux": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "tools",
            "references",
            "external_references"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "section": {
          "$ref": "#/$defs/text"
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "environments": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "linux"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "platform_note": {
          "$ref": "#/$defs/text"
        },
        "accepted_information_types": {
          "$ref": "#/$defs/texts"
        },
        "input_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_binding"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "input_hint": {
          "$ref": "#/$defs/text"
        },
        "correct_usage": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "submission": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/text"
            },
            "warning": {
              "$ref": "#/$defs/text"
            },
            "terms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "warning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "result"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "tools",
                  "external_references"
                ]
              }
            }
          },
          "then": {
            "required": [
              "accepted_information_types",
              "input_bindings",
              "input_hint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external_references"
              }
            }
          },
          "then": {
            "required": [
              "submission",
              "correct_usage",
              "reason"
            ]
          },
          "else": {
            "properties": {
              "submission": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "references"
              }
            }
          },
          "then": {
            "properties": {
              "input_bindings": false,
              "accepted_information_types": false,
              "input_hint": false,
              "correct_usage": false,
              "reason": false,
              "environments": false,
              "platform_note": false
            }
          }
        },
        {
          "if": {
            "required": [
              "correct_usage"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "inspired_by"
        ]
      },
      "then": {
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
