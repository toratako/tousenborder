{
  "schema_version": 1,
  "id": "EMAIL-ARCHIVE-ATTACHMENT",
  "category": "email",
  "platform": "common",
  "level": "intermediate",
  "ground_truth": "block",
  "title": "メール内で添付Archiveを調べる",
  "request": "保留中のEmailを業務メールとして受け入れますか。 ALLOW / BLOCKで判断してください。",
  "initial_information": {
    "Email": "quarantine/message-1083.eml",
    "From": "取引窓口 <orders@cedar.example>",
    "To": "mori@aster.example",
    "Subject": "発注資料",
    "本文": "PDFだけのArchiveを添付しました。",
    "受信時刻": "2026-08-18 09:10",
    "状態": "受信Gatewayで保留。添付未実行・リンク未アクセス。"
  },
  "initial_information_types": {
    "Email": "email"
  },
  "tools": [
    {
      "id": "header",
      "name": "Raw Header / View Source",
      "description": "信頼する受信GatewayのHeaderと保存MIMEを表示し、URL・添付を選べるようにします。",
      "output": "Received: from outbound.cedar.example ([198.51.100.110]) by mx.aster.example with ESMTPS; Tue, 18 Aug 2026 09:10:00 +0900\nAuthentication-Results: mx.aster.example; spf=pass smtp.mailfrom=cedar.example; dkim=pass header.d=cedar.example; dmarc=pass header.from=cedar.example\nFrom: 取引窓口 <orders@cedar.example>\nTo: mori@aster.example\nReply-To: 取引窓口 <orders@cedar.example>\nReturn-Path: <bounce@cedar.example>\nSubject: 発注資料\n\nMIME本文の抜粋:\nContent-Type: application/zip\nContent-Disposition: attachment; filename=\"order-docs.zip\"\nGatewayがMIMEから抽出して保存した添付: /quarantine/attachments/order-docs.zip",
      "accepted_information_types": [
        "email"
      ],
      "input_bindings": [
        {
          "source": "initial_information",
          "id": "Email"
        }
      ],
      "input_hint": "Email",
      "platform_note": "OS共通 / 本教材ではLinuxのメール調査環境",
      "environments": [
        "linux"
      ],
      "output_information": [
        {
          "id": "attachment",
          "label": "抽出済み添付File",
          "value": "/quarantine/attachments/order-docs.zip",
          "data_type": "file"
        }
      ]
    }
  ],
  "references": [
    {
      "id": "gateway",
      "name": "Mail Gateway構成",
      "content": "信頼する受信Gatewayはmx.aster.example。自Gatewayが付けた最上部ReceivedとAuthentication-Resultsだけを認証結果として採用する。外部から同名の認証結果が届いた場合は削除・別記録に保存。通常の転送経路はforward.aster.exampleのみ。"
    },
    {
      "id": "format",
      "name": "受入れ形式",
      "content": "Cedar社との発注資料はPDFのみ。Script・Shortcutを含むArchiveは受け入れない。"
    }
  ],
