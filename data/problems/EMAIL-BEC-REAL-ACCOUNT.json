  "references": [
    {
      "id": "gateway",
      "name": "メールゲートウェイ構成",
      "content": "信頼する受信ゲートウェイはmx.aster.example。自組織のゲートウェイが付けた最上部のReceivedとAuthentication-Resultsだけを認証結果として採用する。外部から同名の認証結果が届いた場合は削除し、別記録に保存する。通常の転送経路はforward.aster.exampleのみ。"
    },
    {
      "id": "vendor",
      "name": "取引先台帳",
      "content": "請求窓口=billing@cedar.example / 配信元198.51.100.110 / DKIM d=cedar.example / 登録口座末尾2048。"
    },
    {
      "id": "thread",
      "name": "過去の取引メール",
      "content": "2026-08-17 PO-821 / billing@cedar.example / 同額請求・口座末尾2048。変更予告なし。"
    },
    {
      "id": "procedure",
      "name": "口座変更手順",
      "content": "口座変更には、変更チケットの発行、登録番号への折り返し確認、経理2名の承認が必須。今回の変更チケット・独立確認・承認はいずれも記録されていない。メール内の電話番号への確認だけでは代替できない。"
    },
    {
      "id": "disclosure",
      "name": "外部照会方針",
      "content": {
        "照会対象": "機密指定のないドメイン・IPアドレスと公開配布ファイルのSHA-256値は、承認済みの外部サービスで照会できます。",
        "ファイル本体": "社外秘ファイルは送信できません。公開配布物は送信できます。",
        "URL": "トークン・ユーザーID・内部ホスト名・機密パスを含むURL全体は送信できません。",
        "メール・PCAP": "本文、添付、認証情報を含むため、本教材の案件では外部送信できません。",
        "今回の資料区分": "社外秘"
      }
    }
  ],
