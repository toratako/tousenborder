    "URL": "https://conference-entry.example/join",
    "URLのHost": "conference-entry.example",
    "受付状態": "通常ブラウザーでは未アクセス。ホスト欄はURLの構文から取得。",
    "URLの区分": "公開イベントの共有リンク、個人トークンなし"
  },
  "initial_information_types": {
    "URL": "url",
    "URLのHost": "domain"
  },
