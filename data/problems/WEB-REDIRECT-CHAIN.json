  "references": [
    {
      "id": "disclosure",
      "name": "外部照会方針",
      "content": {
        "照会対象": "機密指定のないドメイン・IPと公開配布ファイルのSHA-256は、承認された外部サービスへ照会可。",
        "ファイル本体": "社外秘ファイルは送信不可。公開配布物は送信可。",
        "URL": "トークン・ユーザーID・内部ホスト・機密パスを含む完全URLは送信不可。一般公開が確認でき、これらを含まないURLは照会可。",
        "メール・PCAP": "本文、添付、認証情報を含むため本教材の案件では外部送信不可。",
        "今回の資料区分": "照会対象に機密指定はありません。ファイル本体とURL全体の扱いは上記に従います。照会対象のURLは一般公開されています。"
      }
    },
    {
      "id": "official",
      "name": "公式サービス・ドメイン",
      "content": "Aster ログインはlogin.aster.exampleのみ。会議サービスへ組織パスワードを直接渡す認証手順はない。"
    }
  ],
  "external_references": [
    {
      "id": "isolated",
      "name": "隔離環境でのURL解析",
      "description": "外部サービスへ対象を送信し、保存済みの照会結果を表示します。",
      "output": "https://conference-entry.example/join -> 302 https://identity-event.example/login\nHTTP 200\nForm: Aster email / Aster password\nForm action: https://identity-event.example/session",
