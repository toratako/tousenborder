      "environments": [
        "linux"
      ],
      "kind": "tools",
      "section": "添付ファイルの調査",
      "result": {
        "content": "7z l order-docs.zip\nType = zip\norder.pdf\nreview.vbs\nopen-order.lnk"
      }
