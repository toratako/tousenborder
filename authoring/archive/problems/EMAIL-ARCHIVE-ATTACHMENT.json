      "name": "メールゲートウェイ構成",
      "kind": "references",
      "result": {
        "content": "信頼する受信ゲートウェイはmx.aster.example。自社ゲートウェイが付けた最上部ReceivedとAuthentication-Resultsだけを認証結果として採用する。外部から同名の認証結果が届いた場合は削除・別記録に保存。通常の転送経路はforward.aster.exampleのみ。",
        "terms": [
          "gateway",
          "authentication",
          "received",
          "authentication_results"
        ]
      },
      "terms": [
        "gateway"
      ]
    },
    {
      "id": "format",
