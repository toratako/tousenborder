      "result": {
        "content": "Cedar社との発注資料はPDFのみ。スクリプト・ショートカットを含むアーカイブは受け入れない。",
        "terms": [
          "pdf",
          "archive",
          "script",
          "shortcut"
        ]
      }
    },
    {
      "id": "archive",
      "name": "7-Zip",
